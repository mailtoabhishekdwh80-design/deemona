# ── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── MySQL Database ────────────────────────────────────────
DB_SERVER=localhost          # hostname (use 'mysql' inside Docker)
DB_NAME=deemona
DB_USER=root
DB_PASS=YourStrongPassword123!
DB_PORT=3306

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=replace-with-64-char-random-string-for-production
JWT_REFRESH_SECRET=replace-with-different-64-char-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── SMTP (email) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM=Deemona <noreply@deemona.com>

# ── Razorpay ─────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── Stripe (optional) ────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Cloudinary (optional, for product images) ────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
